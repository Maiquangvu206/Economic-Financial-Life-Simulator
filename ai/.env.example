APP_ENV=development
AI_SERVICE_TOKEN=change-me-ai-token
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1200

# Provider: router ưu tiên API credentials, fake chỉ là fallback cuối nếu được giữ trong chain
LLM_PROVIDER=router
LLM_FAILOVER_CHAIN=gemini,openai,fake
AI_PROVIDER_COOLDOWN_SEC=60

# OpenAI (cloud) or OpenAI-compatible local endpoint (Ollama/LM Studio/vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Multiple OpenAI-compatible endpoints for rotation/failover (JSON array). If set, used by router mode.
# OPENAI_ENDPOINTS=[{"base_url":"https://api.groq.com/openai/v1","api_key":"KEY1","model":"llama-3.1-8b-instant"},{"base_url":"http://100.x.y.z:11434/v1","api_key":"","model":"qwen2.5:7b-instruct"}]

# Gemini
GEMINI_API_KEY=
# Multiple Gemini keys for rotation/failover (comma-separated). If set, used by router mode.
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-1.5-flash
