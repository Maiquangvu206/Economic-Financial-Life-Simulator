{
  "name": "efls",
  "version": "0.1.0",
  "private": true,
  "description": "Economic & Financial Life Simulator - HTML5 multiplayer web game",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "infra:stack": "docker compose -f infra/docker/docker-compose.yml --env-file .env --profile app up -d --build",
    "infra:stack:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env --profile app down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml --env-file .env logs -f --tail=200",
    "smoke": "node scripts/smoke.mjs",
    "ai:dev": "cd ai && uvicorn app.main:app --reload --port 8000",
    "ai:test": "cd ai && pytest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
