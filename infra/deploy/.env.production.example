# EFLS production environment (example)
# Copy to the repository root as .env (or inject vars through the service manager).
# Do NOT commit real secrets.

NODE_ENV=production

# --- Database (PostgreSQL, native, low-RAM tuned) ---
DATABASE_URL=postgresql://efls:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/efls
# Some services may read discrete vars depending on config; keep aligned with DATABASE_URL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=efls
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=efls

# --- Redis (native, required by realtime) ---
REDIS_URL=redis://127.0.0.1:6379
AI_SERVICE_URL=http://127.0.0.1:8000

# --- Security / tokens (generate unique random values) ---
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
INTERNAL_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN
AI_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_AI_SERVICE_TOKEN
# AI (recommend: local on separate Tailscale machine, or stable primary). Free-tier rotation via router:
# LLM_PROVIDER=router
# LLM_FAILOVER_CHAIN=openai,gemini,fake
# OPENAI_ENDPOINTS=[{"base_url":"https://api.example/v1","api_key":"KEY","model":"model"},{"base_url":"http://100.x.y.z:11434/v1","api_key":"","model":"qwen2.5:7b-instruct"}]
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODEL=gemini-1.5-flash
# AI_REQUEST_TIMEOUT_MS=30000
# AI_PROVIDER_COOLDOWN_SEC=60

# --- Service ports (behind Nginx reverse proxy) ---
API_GATEWAY_PORT=3000
GAME_CORE_PORT=4000
REALTIME_PORT=5000
# WORKER_PORT=...

# --- Public origins (Cloudflare Tunnel / public domains) ---
WEB_ORIGIN=https://play.example.com
ADMIN_ORIGIN=https://admin.example.com
# Base URLs used by frontends at build time (set in CI/build env, then rebuild dist)
VITE_API_BASE_URL=https://api.example.com
VITE_REALTIME_URL=https://realtime.example.com
VITE_PORTAL_URL=https://play.example.com
VITE_ADMIN_URL=https://admin.example.com

# --- Logging ---
LOG_LEVEL=info
