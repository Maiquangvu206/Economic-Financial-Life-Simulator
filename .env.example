# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Production Compose deployment (replace all placeholder secrets on the host)
# ---------------------------------------------------------------------------
PUBLIC_ORIGIN=https://efls.zorse-mizar.ts.net
TS_AUTHKEY=tskey-auth-replace-with-a-tailnet-auth-key

# ---------------------------------------------------------------------------
# Public endpoints (browser)
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3000
VITE_REALTIME_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
GATEWAY_PORT=3000
CORE_PORT=4000
REALTIME_PORT=5000
WORKER_METRICS_PORT=6060
AI_PORT=8000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
POSTGRES_USER=efls
POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password
POSTGRES_DB=efls
POSTGRES_PORT=55432
DATABASE_URL=postgresql://efls:efls@localhost:55432/efls

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security / internal service mesh
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token

# ---------------------------------------------------------------------------
# AI subsystem
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-long-random-ai-service-token
AI_REQUEST_TIMEOUT_MS=15000
AI_SWEEP_INTERVAL_MS=10800000
# router | fake | openai | gemini. Router thử API có key theo thứ tự rồi mới dùng fake dự phòng.
LLM_PROVIDER=router
LLM_FAILOVER_CHAIN=gemini,openai,fake
AI_PROVIDER_COOLDOWN_SEC=60
# Local/single OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Nhiều endpoint OpenAI-compatible (JSON array) cho router: [{"base_url":"...","api_key":"...","model":"..."}]
OPENAI_ENDPOINTS=
GEMINI_API_KEY=
# Nhiều Gemini key (phân tách dấu phẩy) cho router
GEMINI_API_KEYS=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Game loop
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Chuẩn hệ thống: 1 ngày game = 1 phút thực tế (60000ms/tick)
GAME_TICK_INTERVAL_MS=60000
AI_NEWS_CRON=0 6 * * *
REALTIME_CHANNEL=efls:realtime
DOMAIN_EVENT_CHANNEL=efls:domain-events
