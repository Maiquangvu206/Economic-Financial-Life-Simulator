# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Public endpoints (browser)
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3000
VITE_REALTIME_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
GATEWAY_PORT=3000
CORE_PORT=4000
REALTIME_PORT=5000
WORKER_METRICS_PORT=6060
AI_PORT=8000

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
POSTGRES_USER=efls
POSTGRES_PASSWORD=efls
POSTGRES_DB=efls
POSTGRES_PORT=55432
DATABASE_URL=postgresql://efls:efls@localhost:55432/efls

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security / internal service mesh
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# ---------------------------------------------------------------------------
# AI subsystem
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-ai-token
AI_REQUEST_TIMEOUT_MS=15000
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Game loop
# ---------------------------------------------------------------------------
LOG_LEVEL=info
GAME_TICK_INTERVAL_MS=86400000
AI_NEWS_CRON=0 6 * * *
REALTIME_CHANNEL=efls:realtime
DOMAIN_EVENT_CHANNEL=efls:domain-events
